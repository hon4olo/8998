          "animator": {
            "layerTimeJsCode": "const t = input.time.seconds; const w=12,z=.68,d=w*Math.sqrt(1-z*z); const s=1-Math.exp(-z*w*t)*(Math.cos(d*t)+z*w/d*Math.sin(d*t)); return 80+240*s;",
            "type": "jsScript"
          },
          "target": {
            "kind": "layer",
            "layerId": 1,
            "propertyType": "positionX"
          }
        },
        {
          "animator": {
            "enabled": true,
            "keyframes": [
              {
                "easing": {
                  "type": "linear"
                },
                "id": "r0",
