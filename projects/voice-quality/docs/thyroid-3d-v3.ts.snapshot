import * as THREE from 'three';
import data from '../../projects/voice-quality/assets/structures/geometry.json';
import {clamp,mix} from '../animation/math';
const ease=(t:number,a:number,b:number)=>{const u=clamp((t-a)/(b-a));return u*u*u*(10+u*(-15+6*u));};
const v=(p:number[])=>new THREE.Vector3(...p as [number,number,number]);
const Y=new THREE.Vector3(0,1,0);
function material(color:number,shininess=70){return new THREE.MeshPhongMaterial({color,specular:0x8caaa8,shininess});}
const palette={C:0xdce1d3,O:0xc06348,N:0x729fb8,I:0xd6a267};
export class ThyroidStage{
 renderer:THREE.WebGLRenderer;scene=new THREE.Scene();camera=new THREE.PerspectiveCamera(38,1080/1920,.1,600);
 ligand=new THREE.Group();protein=new THREE.Group();dna=new THREE.Group();moleculeAtoms=new Map<string,THREE.Mesh>();moleculeBonds:{mesh:THREE.Mesh;a:string;b:string;order:string}[]=[];
 clip=new THREE.Plane(new THREE.Vector3(0,0,-1),100);surface:THREE.InstancedMesh;surfaceMaterial:THREE.MeshPhongMaterial;backbone:THREE.Group;revision=3;
 constructor(){
  this.renderer=new THREE.WebGLRenderer({alpha:true,antialias:true,preserveDrawingBuffer:true,powerPreference:'low-power'});
  this.renderer.setSize(1080,1920);this.renderer.setPixelRatio(1);this.renderer.setClearColor(0x061719,0);this.renderer.localClippingEnabled=true;
  this.renderer.outputColorSpace=THREE.SRGBColorSpace;this.renderer.toneMapping=THREE.ACESFilmicToneMapping;this.renderer.toneMappingExposure=1.15;
  this.scene.add(new THREE.HemisphereLight(0xe6f0df,0x071820,1.3));
  const key=new THREE.DirectionalLight(0xffe4bd,3.2);key.position.set(-25,35,45);this.scene.add(key);
  const rim=new THREE.DirectionalLight(0x77b7c9,3.4);rim.position.set(25,8,-30);this.scene.add(rim);
  const fill=new THREE.DirectionalLight(0x719f9e,.8);fill.position.set(-30,-15,5);this.scene.add(fill);
  const sphere=new THREE.SphereGeometry(1,24,16),cylinder=new THREE.CylinderGeometry(1,1,1,12);
  for(const atom of data.t4.atoms){const mat=material(palette[atom.e as keyof typeof palette]??0xc8d3cb,atom.e==='I'?100:65);const mesh=new THREE.Mesh(sphere,mat);mesh.scale.setScalar(atom.e==='I'?.69:atom.e==='O'?.43:.38);this.moleculeAtoms.set(atom.id,mesh);this.ligand.add(mesh);}
  for(const [a,b,order] of data.t4.bonds){const mesh=new THREE.Mesh(cylinder,material(0x9daaa3,90));this.moleculeBonds.push({mesh,a,b,order});this.ligand.add(mesh);}
  this.scene.add(this.ligand,this.protein,this.dna);
  this.backbone=new THREE.Group();this.protein.add(this.backbone);
  // Cartesian alpha-carbon trace from 2H77. Spline smoothing is a visual interpolation, not invented folding.
  const groups:typeof data.backbone[]=[];let group:typeof data.backbone=[];
  for(const a of data.backbone){if(group.length&&a.res-group[group.length-1].res>1){groups.push(group);group=[];}group.push(a);}if(group.length)groups.push(group);
  for(const points of groups){if(points.length<2)continue;const curve=new THREE.CatmullRomCurve3(points.map(a=>v(a.p)),false,'centripetal');
   const n=points.length*6;const frames=curve.computeFrenetFrames(n,false);const pos:number[]=[],idx:number[]=[];
   for(let i=0;i<=n;i++){const p=curve.getPointAt(i/n),j=Math.min(points.length-1,Math.floor(i/n*(points.length-1)));const width=points[j].helix?.85:.23,depth=points[j].helix?.18:.23;
    for(let k=0;k<8;k++){const q=p.clone().addScaledVector(frames.normals[i],Math.cos(k*Math.PI/4)*width).addScaledVector(frames.binormals[i],Math.sin(k*Math.PI/4)*depth);pos.push(q.x,q.y,q.z);}
    if(i<n)for(let k=0;k<8;k++){const a=i*8+k,b=i*8+(k+1)%8;idx.push(a,b,a+8,b,b+8,a+8);}
   }
   const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.Float32BufferAttribute(pos,3));g.setIndex(idx);g.computeVertexNormals();const mat=material(0x8fbbb0,100);mat.side=THREE.DoubleSide;this.backbone.add(new THREE.Mesh(g,mat));
  }
  this.surfaceMaterial=material(0x597b75,45);this.surfaceMaterial.clippingPlanes=[this.clip];
  this.surface=new THREE.InstancedMesh(new THREE.SphereGeometry(1,12,8),this.surfaceMaterial,data.proteinAtoms.length);
  const m=new THREE.Matrix4(),q=new THREE.Quaternion();data.proteinAtoms.forEach((a,i)=>{const r=({C:1.7,N:1.55,O:1.52,S:1.8} as Record<string,number>)[a.e]??1.7;m.compose(v(a.p),q,new THREE.Vector3(r*.82,r*.82,r*.82));this.surface.setMatrixAt(i,m);});this.surface.instanceMatrix.needsUpdate=true;this.protein.add(this.surface);
  // Idealized B-DNA illustration, not a DNA sequence or a claimed complex with the LBD.
  for(let strand=0;strand<2;strand++){const pts=[];for(let i=0;i<=280;i++){const x=-45+i*90/280,a=x/11.9*Math.PI*2+strand*Math.PI;pts.push(new THREE.Vector3(x,Math.sin(a)*3.2,Math.cos(a)*3.2));}const path=new THREE.CatmullRomCurve3(pts);this.dna.add(new THREE.Mesh(new THREE.TubeGeometry(path,560,.31,10,false),material(strand?0xc19564:0xc4ded2,90)));}
  for(let x=-45;x<=45;x+=1.13){const a=x/11.9*Math.PI*2;const p=new THREE.Vector3(x,Math.sin(a)*3.2,Math.cos(a)*3.2),q=new THREE.Vector3(x,-Math.sin(a)*3.2,-Math.cos(a)*3.2);const mesh=new THREE.Mesh(new THREE.CylinderGeometry(.12,.12,1,8),material(Math.abs(x)<7?0xc4ad84:0x497b7b,40));this.connect(mesh,p,q,.12);this.dna.add(mesh);}
 }
 connect(mesh:THREE.Mesh,a:THREE.Vector3,b:THREE.Vector3,r:number){const delta=b.clone().sub(a);mesh.position.copy(a).add(b).multiplyScalar(.5);mesh.quaternion.setFromUnitVectors(Y,delta.clone().normalize());mesh.scale.set(r,delta.length(),r);}
 render(t:number,revision:number){
  this.revision=revision;const conversion=ease(t,2.05,3.96),docking=ease(t,5.9,6.9),reveal=ease(t,4.85,5.6),genome=ease(t,9.85,10.5);
  const positions=new Map<string,THREE.Vector3>();
  for(const a of data.t4.atoms){const b=data.t3.atoms.find(b=>b.id===a.id);const p=v(a.p);if(b)p.lerp(v(b.p),conversion);else p.add(new THREE.Vector3(conversion*7,conversion*5,conversion*4));positions.set(a.id,p);const mesh=this.moleculeAtoms.get(a.id)!;mesh.position.copy(p);mesh.visible=!!b||conversion<.98;}
  for(const b of this.moleculeBonds){b.mesh.visible=!(b.a==="I5'"||b.b==="I5'")||conversion<.08;this.connect(b.mesh,positions.get(b.a)!,positions.get(b.b)!,b.order==='DOUB'?.125:.09);}
  // Ligand changes relative placement only during a deliberately schematic approach, and ends in the crystallographic pose.
  this.ligand.position.set(mix(0,-10,reveal)*(1-docking),mix(0,8,reveal)*(1-docking),mix(0,12,reveal)*(1-docking));
  this.ligand.visible=t<10.5;this.protein.visible=t>=4.85&&t<10.5;
  const cut=ease(t,5.2,8.7);this.clip.constant=mix(24,-10,cut);this.surface.visible=t<8.75;
  this.backbone.visible=true;
  this.dna.visible=t>=9.85;this.dna.rotation.set(.16+t*.035,-.15,-.65);this.dna.position.set(0,-4,mix(-100,0,genome));
  let dist=mix(39,100,reveal);let angle=mix(-.20,.28,ease(t,1.2,4.8))+ease(t,5.6,9.8)*.64;
  const into=ease(t,7,9.8);dist-=into*13;
  let target=new THREE.Vector3(0,4+reveal*5,0);
  if(t>=9.85){dist=mix(dist,62,genome);angle=mix(angle,.14,genome);target.lerp(new THREE.Vector3(mix(0,10,ease(t,10.5,12.4)),5,0),genome);}
  this.camera.position.set(Math.sin(angle)*dist,8+reveal*13,Math.cos(angle)*dist);this.camera.lookAt(target);this.camera.updateMatrixWorld();
  this.renderer.render(this.scene,this.camera);this.renderer.getContext().finish();return this.renderer.domElement;
 }
}
